{
  "name": "tthe/bagatelle-core",
  "description": "Configuration and components for tthe/bagatelle.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "tthe\\Bagatelle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "symfony/http-kernel": "^8.0",
    "symfony/http-foundation": "^8.0",
    "symfony/event-dispatcher": "^8.0",
    "symfony/routing": "^8.0",
    "symfony/console": "^8.0",
    "symfony/config": "^8.0",
    "symfony/psr-http-message-bridge": "^8.0",
    "symfony/monolog-bridge": "^8.0",
    "twig/twig": "^3.21",
    "php-di/php-di": "^7.1",
    "monolog/monolog": "^3.9",
    "nyholm/psr7": "^1.8",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.93",
    "pestphp/pest": "^4.6",
    "mockery/mockery": "^1.6"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
