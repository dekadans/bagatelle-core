<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- "prohibited" from twemoji -->
    <link rel="icon" href="data:image/svg+xml;base64," />
    <title>{{ page_title ?? 'Error!' }}</title>
    {{ include('@bagatelle/style.html.twig') }}
</head>
<body>
<main>
    <section>
        <h1>{{ title }}</h1>
        <p>{{ message }}</p>
    </section>

    {% if exception %}
        <section>
            <h2>Exception Details</h2>
            <pre><code>
{%- for ex in exception %}
<span class="error-type">{{ ex.class }}</span>
{% if ex.message -%} {{ ex.message }} {%- endif %}


<span class="error-type">Stack trace:</span>
{% for trace in ex.trace %}
at <span class="file-path">{{ trace.file }}</span>:<span class="line-number">{{ trace.line }}</span>
    {{ trace.function }}
{% endfor %}

<hr>
{% endfor %}
            </code></pre>
        </section>
    {% endif %}
</main>
</body>
</html>